# Copy this file to .env.content-growth and fill values.
# Do not commit .env.content-growth.

# LLM provider. At least one is required by pi.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# DataForSEO keyword/SERP data.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Parallel search API.
PARALLEL_API_KEY=
# Optional override if your account uses a different endpoint/version.
PARALLEL_API_BASE=

# Google Search Console.
# Option A: paste an OAuth/access token.
GSC_ACCESS_TOKEN=

# Option B: use a service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=

# Option C: paste raw service account JSON as one line.
# Usually easier locally to use GOOGLE_APPLICATION_CREDENTIALS above.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
